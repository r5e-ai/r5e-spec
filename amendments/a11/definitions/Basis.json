{"conformsTo":[],"description":"Immutable capture-time governance record stating who holds which powers, under what authority, and with what explanation. A Basis naming a human person requires two distinct valid signatures (institution and person/representative or device_session).","format":"r5e.kind-definition/v1","kind":"provenance.r5e.io/v2/Basis","naming":{"mode":"content"},"requiresAuthority":false,"schema":{"additionalProperties":false,"nonEmpty":["grounds"],"properties":{"actor":{"description":"A stable identity written as a URI. Syntax is not authentication.","pattern":"^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$","type":"string"},"declaredTerms":{"items":{"additionalProperties":false,"nonEmpty":["termId","scope","statement"],"properties":{"enforceable":{"type":"boolean"},"scope":{"maxLength":256,"type":"string"},"statement":{"maxLength":1024,"type":"string"},"termId":{"maxLength":128,"type":"string"}},"required":["termId","scope","enforceable","statement"],"type":"object"},"type":"array","unique":true},"details":{"description":"Issuer-defined detail: up to 64 named scalars. Nothing in it is interpreted by the base kinds, and nothing in it is content; content goes behind a reference.","keys":"^[A-Za-z][A-Za-z0-9_.-]{0,63}$","maxEntries":64,"type":"object","values":{"maxLength":2048,"type":["string","integer","boolean"]}},"explanationRef":{"description":"A content reference, either bare (bytes:sha256:...) or salted (bytes:sha256+salt:...).","pattern":"^bytes:sha256(\\+salt)?:[0-9a-f]{64}$","type":"string"},"grounds":{"items":{"additionalProperties":false,"nonEmpty":["groundId","recordClasses","powers","instrument"],"properties":{"groundId":{"maxLength":128,"type":"string"},"instrument":{"maxLength":512,"type":"string"},"powers":{"items":{"additionalProperties":false,"nonEmpty":["purpose"],"properties":{"approvalRule":{"additionalProperties":false,"nonEmpty":["roles"],"properties":{"roles":{"items":{"maxLength":128,"pattern":"^.+$","type":"string"},"type":"array","unique":true},"threshold":{"maximum":64,"minimum":1,"type":"integer"}},"required":["roles","threshold"],"type":"object"},"duration":{"additionalProperties":false,"exactlyOne":[["until","untilEvent"]],"nonEmpty":["untilEvent"],"properties":{"until":{"description":"RFC 3339 UTC Z-terminated instant with up to nanosecond precision.","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$","type":"string"},"untilEvent":{"maxLength":256,"type":"string"}},"type":"object"},"power":{"enum":["capture","keep","read","inspect","disclose","dispose","hold","seal","derive","annotate","reclassify","train_on"],"type":"string"},"purpose":{"maxLength":512,"type":"string"}},"required":["power","purpose","approvalRule","duration"],"type":"object"},"type":"array","unique":true},"recordClasses":{"items":{"maxLength":128,"pattern":"^.+$","type":"string"},"type":"array","unique":true}},"required":["groundId","recordClasses","powers"],"type":"object"},"type":"array","unique":true},"institution":{"description":"A stable identity written as a URI. Syntax is not authentication.","pattern":"^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$","type":"string"},"representative":{"description":"A stable identity written as a URI. Syntax is not authentication.","pattern":"^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$","type":"string"},"subjects":{"items":{"description":"A stable identity written as a URI. Syntax is not authentication.","pattern":"^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$","type":"string"},"type":"array","unique":true},"supersedesRef":{"description":"The identity of one signed evidence record.","ref":{"evidence":true},"type":"ref"}},"required":["institution","actor","subjects","grounds","explanationRef"]},"signatures":1,"substrate":"event"}