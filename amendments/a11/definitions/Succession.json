{"conformsTo":[],"description":"One key hands over to another, either via standard dual-key signature (predecessor and successor) or via recovery form (successor signature plus recoveryProof meeting a registered recoveryRule).","format":"r5e.kind-definition/v1","kind":"provenance.r5e.io/v2/Succession","naming":{"mode":"content"},"requiresAuthority":false,"schema":{"additionalProperties":false,"nonEmpty":["reason"],"properties":{"details":{"description":"Issuer-defined detail: up to 64 named scalars. Nothing in it is interpreted by the base kinds, and nothing in it is content; content goes behind a reference.","keys":"^[A-Za-z][A-Za-z0-9_.-]{0,63}$","maxEntries":64,"type":"object","values":{"maxLength":2048,"type":["string","integer","boolean"]}},"predecessor":{"pattern":"^key:[a-z0-9-]+:sha256:[0-9a-f]{64}$","type":"string"},"reason":{"type":"string"},"recoveryProof":{"additionalProperties":false,"nonEmpty":["approvals"],"properties":{"approvals":{"items":{"additionalProperties":false,"nonEmpty":["signature"],"properties":{"signature":{"pattern":"^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$","type":"string"},"signerKey":{"pattern":"^key:[a-z0-9-]+:sha256:[0-9a-f]{64}$","type":"string"}},"required":["signerKey","signature"],"type":"object"},"type":"array","unique":true},"recoveryRuleRef":{"description":"The identity of one signed evidence record.","ref":{"evidence":true},"type":"ref"}},"required":["recoveryRuleRef","approvals"],"type":"object"},"successor":{"derives":{"keyIdOf":"successorKey"},"pattern":"^key:[a-z0-9-]+:sha256:[0-9a-f]{64}$","type":"string"},"successorKey":{"additionalProperties":false,"description":"A public key: a registered algorithm and the key's bytes in strict padded base64.","keyBytes":true,"properties":{"algorithm":{"pattern":"^[a-z0-9-]+$","type":"string"},"bytes":{"type":"string"}},"required":["algorithm","bytes"],"type":"object"}},"required":["predecessor","successor","successorKey"]},"signatures":1,"substrate":"event"}